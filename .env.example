# ── 데이터 출처 ────────────────────────────────────────────────
# 비워두면 자동: 아래 키가 있으면 supabase, 없으면 mock.
# 강제하려면 mock 또는 supabase.
NEXT_PUBLIC_DATA_SOURCE=

# ── Supabase ──────────────────────────────────────────────────
# 로컬: npm run db:start 가 출력하는 API_URL 과 ANON_KEY
# 원격: 프로젝트 > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
# 크레딧 정산(hold·commit·refund)과 생성 결과 저장이 이 키로만 된다. 실 테스트에 필요하다.
# 로컬: npm run db:start 출력의 SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=

# Supabase pg_cron 이 /api/queue/run · /api/cron/daily 를 부를 때 쓰는 비밀값. 아무 긴 문자열.
CRON_SECRET=

# ── 생성 ──────────────────────────────────────────────────────
# 콘티(2.2)와 게시물 캡션(4.1) 생성. 비우면 사연 문장으로 짠 목 결과를 쓴다.
ANTHROPIC_API_KEY=

# 목 이미지 생성기가 첫 시도에 일부러 실패시킬 컷 번호(쉼표 구분). 실패·환불 화면을 보려고 둔다.
# 끄려면 빈 값으로 둔다. 지우면 기본값 4.
SHARKTOON_MOCK_FAIL_CUTS=4

# ── 이미지 생성 모델 ──────────────────────────────────────────
# 선택값: mock | openai | google | fal-schnell | fal-dev (비워두면 키 유무에 따라 자동 선택)
SHARKTOON_IMAGE_PROVIDER=mock

# OpenAI API 키 (GPT Image 2.5 sunburst / flare)
OPENAI_API_KEY=

# Google AI Studio API 키 (Imagen 3)
GOOGLE_AI_API_KEY=

# Fal.ai API 키 (Flux.1 schnell / dev)
FAL_KEY=


# ── 인스타그램 연동 (Instagram API with Instagram Login) ──────
# Meta 앱 대시보드 > Instagram > API setup with Instagram login 의 앱 ID·시크릿.
# 앱 심사(Advanced Access)·비즈니스 인증 전에는 앱에 역할(테스터)로 등록한 계정만 로그인된다.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# 대시보드의 "Valid OAuth Redirect URIs" 와 글자 하나까지 같아야 한다. 예: https://<앱 주소>/api/instagram/callback
INSTAGRAM_REDIRECT_URI=
# 장기 토큰 암호화 키(32바이트). openssl rand -base64 32
INSTAGRAM_TOKEN_KEY=
# true 일 때만 화면에 실제 발행·연결 버튼이 나온다. 사업자 등록·앱 심사 전에는 비워 둔다("출시 예정").
# 실제 연동은 Supabase 모드에서만 돈다(Meta 가 이미지를 가져갈 서명 URL 이 필요하다).
INSTAGRAM_PUBLISH_ENABLED=
